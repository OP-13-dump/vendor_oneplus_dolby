// AIDL adapter for the legacy (AELI-only) Dolby DAP engine in libswdap.so.
// The AIDL effect factory dlsyms createEffect/queryEffect/destroyEffect, which
// libswdap.so does not export, so it is loaded here through the legacy
// audio_effect_library_t interface instead.
cc_library_shared {
    name: "libswdapaidl",

    defaults: [
        "aidlaudioeffectservice_defaults",
    ],

    srcs: [
        "DolbyDapEffect.cpp",
    ],

    local_include_dirs: ["."],

    header_libs: [
        "libhardware_headers",
    ],

    // libswdap.so is opened at runtime, not linked, so that a device without
    // the Dolby blobs still gets a loadable (if inert) library.
    required: [
        "libswdap",
    ],

    relative_install_path: "soundfx",

    visibility: [
        "//hardware/interfaces/audio/aidl/default:__subpackages__",
    ],

    vendor: true,
}
